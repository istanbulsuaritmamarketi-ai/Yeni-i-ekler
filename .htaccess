# ==============================================================================
# 🌸 YENİÇİÇEK — KÖK DİZİN (ROOT) APACHE / CPANEL YÖNLENDİRİCİSİ (.HTACCESS)
# ==============================================================================
# Eğer sunucunuz / hosting sağlayıcınız 'public/' klasörünü doğrudan document root
# yapamıyorsa (örneğin standart cPanel public_html içine tüm proje yüklendiğinde),
# bu dosya istekleri güvenle /public klasörüne yönlendirir ve sistem dosyalarını gizler.
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Hassas sistem dosyalarına doğrudan web erişimini engelle
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.(json|lock)|artisan|phpunit\.xml) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests)/ - [F,L,NC]

    # İstekleri şeffaf olarak /public klasörüne yönlendir
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
