# ==============================================================================
# 🌸 YENİÇİÇEK — CANLI SUNUCU (PRODUCTION) .ENV ŞABLONU
# ==============================================================================
# Bu dosyayı sunucuda '.env' olarak kaydedin ve değerleri doldurun:
#   cp .env.production.example .env
#   php artisan key:generate
# ==============================================================================

APP_NAME="Yeniçiçek"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yenicicek.com

# Site Modu & Tema
SITE_MODE=ecommerce
THEME=rose
ACTIVE_DISTRICTS=all
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

# Günlük Kayıtları (Log)
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# ------------------------------------------------------------------------------
# 🗄️ VERİTABANI BAĞLANTISI (MySQL / MariaDB Önerilir)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yenicicek_db
DB_USERNAME=yenicicek_user
DB_PASSWORD=Guvendi_Sifreniz_Buraya!

# (Eğer SQLite kullanılacaksa yukarısını DB_CONNECTION=sqlite yapıp altını açın)
# DB_CONNECTION=sqlite
# DB_DATABASE=/tam/yol/database/database.sqlite

# ------------------------------------------------------------------------------
# ⚡ OTURUM, ÖNBELLEK VE KUYRUK YÖNETİMİ
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=yenicicek_session

CACHE_STORE=database
CACHE_PREFIX=yenicicek_cache_

QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# ------------------------------------------------------------------------------
# 💳 PAYTR SANAL POS ÖDEME ENTEGRASYONU
# ------------------------------------------------------------------------------
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=0
PAYTR_DEBUG_ON=0

# ------------------------------------------------------------------------------
# 📧 E-POSTA / SMTP AYARLARI (Sipariş & Müşteri Bildirimleri)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.yenicicek.com
MAIL_PORT=587
MAIL_USERNAME=info@yenicicek.com
MAIL_PASSWORD=Eposta_Sifreniz!
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@yenicicek.com"
MAIL_FROM_NAME="Yeniçiçek Çiçekçilik"

# ------------------------------------------------------------------------------
# 📱 SMS BAŞLIKLI MESAJLAŞMA ENTEGRASYONU (Netgsm / İletimerkezi)
# ------------------------------------------------------------------------------
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER="YENICICEK"

# ------------------------------------------------------------------------------
# 🛠️ DİĞER SİSTEM AYARLARI
# ------------------------------------------------------------------------------
BCRYPT_ROUNDS=12
VITE_APP_NAME="${APP_NAME}"
